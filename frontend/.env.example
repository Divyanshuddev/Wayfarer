# -----------------------------------------------------------------------------
# WAYFARER FRONTEND (NEXT.JS) - VERCEL ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Backend API URL (Set to your live Render backend URL, e.g., https://wayfarer-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Application Domain (Set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: OpenAI API Key (for client-side fallback)
# OPENAI_API_KEY=sk-proj-your-key-here
