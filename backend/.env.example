# -----------------------------------------------------------------------------
# WAYFARER BACKEND (FASTAPI) - RENDER ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Port is automatically assigned by Render via $PORT (defaults to 8001 locally)
PORT=8001

# OpenAI API Key for AI Travel Advice & Hotel Price Intelligence
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# CORS Allowed Origins (Comma-separated URLs; *.vercel.app is automatically allowed)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
